{
  "name": "xuvon-browser",
  "version": "0.1.0",
  "private": true,
  "description": "Xuvon Browser (旭文瀏覽器) — a minimalist, privacy-focused Chromium browser with a Rust application core.",
  "license": "MIT",
  "author": "Seb",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "npm run build:core && npm run build:main && concurrently -k -n VITE,ELECTRON -c cyan,magenta \"vite --port 5173 --strictPort\" \"wait-on tcp:5173 && cross-env XUVON_DEV=1 electron .\"",
    "start": "npm run build && npm run build:core && electron .",
    "build": "npm run typecheck && npm run build:main && vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build:core": "cargo build --manifest-path core/Cargo.toml",
    "build:core:release": "cargo build --release --manifest-path core/Cargo.toml",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit",
    "test": "npm run test:core && npm run test:e2e",
    "test:core": "cargo test --manifest-path core/Cargo.toml",
    "test:e2e": "npm run build && npm run build:core && playwright test",
    "icons": "node scripts/generate-icons.mjs",
    "package": "npm run icons && npm run build && npm run build:core:release && electron-builder",
    "package:dir": "npm run icons && npm run build && npm run build:core:release && electron-builder --dir",
    "package:win": "npm run icons && npm run build && npm run build:core:release && electron-builder --win nsis"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tldts": "7.4.18",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "10.0.6",
    "cross-env": "10.1.0",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "wait-on": "9.5.1"
  },
  "build": {
    "appId": "app.xuvon.browser",
    "productName": "Xuvon Browser",
    "copyright": "Copyright © 2026 Seb",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.ts"
    ],
    "afterPack": "scripts/afterPack.cjs",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extraResources": [
        {
          "from": "target/release/xuvon-core",
          "to": "bin/xuvon-core"
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "target/release/xuvon-core.exe",
          "to": "bin/xuvon-core.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network;WebBrowser",
      "icon": "build/icon.png",
      "maintainer": "Seb",
      "extraResources": [
        {
          "from": "target/release/xuvon-core",
          "to": "bin/xuvon-core"
        }
      ]
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  }
}
